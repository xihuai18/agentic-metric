/* agentic-metric TUI — theme-aware styles.
 *
 * Only Textual semantic variables are used here ($surface, $panel,
 * $boost, $primary, $accent, $warning, $success, $text, $text-muted,
 * $border). That lets Textual's theme machinery pick concrete colors
 * from whatever theme the user chose (default: textual-dark; override
 * via the App's theme setter or ``TEXTUAL_THEME=<name>``).
 *
 * Widget-level text colors are set in Python using 8-color ANSI names
 * so they follow the terminal's palette instead of hard-coding hex.
 */

Header {
    background: $boost;
    color: $text;
}

Footer {
    background: $boost;
    color: $text;
}

Footer > .footer--key {
    background: $warning;
    color: $surface;
    text-style: bold;
}

/* Highlight the R binding in the footer while auto-refresh is running.
 * Both the key cell and the "Auto" label light up so the active state
 * is obvious at a glance. */
FooterKey.-auto-on {
    background: $success;
    color: $surface;
    text-style: bold;
    .footer-key--key {
        color: $surface;
        background: $success;
        text-style: bold;
    }
    .footer-key--description {
        color: $surface;
        background: $success;
        text-style: bold;
    }
}

/* ─── Top summary row: 3 cells side by side ─── */

#summary-row {
    height: auto;
    min-height: 7;
    max-height: 9;
    margin: 1 1 0 1;
}

SummaryCell {
    width: 1fr;
    height: 1fr;
    margin: 0 1;
    padding: 0 2;
    border: round white;
    content-align: left top;
}

SummaryCell.-focused {
    border: round $warning;
    background: $panel-lighten-1;
}

/* ─── Hourly heatmap (today only) ─── */

#heatmap-panel {
    height: auto;
    min-height: 11;
    margin: 0 1;
    padding: 0 1;
    border: round white;
    border-title-align: left;
    border-title-color: $text;
    border-title-style: bold;
}

#heatmap {
    height: auto;
    min-height: 4;
}

/* ─── Compact trend strip ─── */

#chart-panel {
    height: 6;
    min-height: 6;
    max-height: 6;
    margin: 0 1;
    padding: 0 1;
    border: round white;
    border-title-align: left;
    border-title-color: $text;
    border-title-style: bold;
}

#chart {
    height: auto;
    min-height: 4;
}

/* ─── Breakdown ─── */

#breakdown-panel {
    height: 1fr;
    min-height: 4;
    margin: 0 1 1 1;
    padding: 0 1;
    border: round white;
    border-title-align: left;
    border-title-color: $text;
    border-title-style: bold;
}

#breakdown-scroll {
    height: 1fr;
    scrollbar-size-vertical: 1;
    scrollbar-background: $surface;
    scrollbar-color: $text-muted;
    scrollbar-color-hover: $text;
    scrollbar-color-active: $accent;
}

#breakdown-body {
    height: auto;
    min-height: 1;
}

/* ─── Pricing modal (press p) ─── */

PricingScreen {
    align: center middle;
}

#pricing-box {
    width: 90%;
    max-width: 110;
    height: 85%;
    background: $surface;
    border: round $warning;
    padding: 1 2;
}

#pricing-content {
    width: auto;
    height: auto;
}

/* ─── Help modal (press ?) ─── */

HelpScreen {
    align: center middle;
}

#help-box {
    width: 70%;
    max-width: 80;
    height: auto;
    max-height: 85%;
    background: $surface;
    border: round $accent;
    padding: 1 2;
}

#help-content {
    width: auto;
    height: auto;
}
